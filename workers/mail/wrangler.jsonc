// Email Worker forwarding contact@dfxa.at to both experts (see
// docs/cloudflare.md, section "Mail"). Deployed as a separate Worker
// ("dfxa-mail") with root directory workers/mail.
// Secret (set in the dashboard or with `npx wrangler secret put FORWARD_TO`):
//   FORWARD_TO = "first@example.org,second@example.org"
{
  "name": "dfxa-mail",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false
}
